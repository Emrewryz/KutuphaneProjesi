@{
    Layout = "_AuthLayout";
}
@model KutuphaneProjesi.Models.Kullanici

@{
    ViewData["Title"] = "Giriş Yap";
}

<h1>Giriş Yap</h1>
<h4>Lütfen hesabınıza giriş yapın.</h4>
<hr />
<div class="row">
    <div class="col-md-12">
        
        <form asp-action="Login">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Eposta" class="control-label"></label>
                <input asp-for="Eposta" class="form-control" />
                <span asp-validation-for="Eposta" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <label asp-for="Sifre" class="control-label"></label>
                <input asp-for="Sifre" class="form-control" />
                <span asp-validation-for="Sifre" class="text-danger"></span>
            </div>
            <div class="form-group mt-4">
                <input type="submit" value="Giriş Yap" class="btn btn-primary w-100" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Register">Hesabınız yok mu? Kayıt Olun</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}