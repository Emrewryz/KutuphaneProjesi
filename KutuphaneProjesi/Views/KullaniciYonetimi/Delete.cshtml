@model KutuphaneProjesi.Models.Kullanici

@{
    ViewData["Title"] = "Kullanıcıyı Sil";
}

<h1>Kullanıcıyı Sil</h1>

<h3>Bu kullanıcıyı kalıcı olarak silmek istediğinizden emin misiniz?</h3>
<div>
    <h4>Kullanıcı Bilgileri</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Kullanıcı Adı</dt>
        <dd class="col-sm-10">@Model.KullaniciAdi</dd>

        <dt class="col-sm-2">E-posta</dt>
        <dd class="col-sm-10">@Model.Eposta</dd>

        <dt class="col-sm-2">Rol</dt>
        <dd class="col-sm-10">@Model.Rol</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Evet, Sil" class="btn btn-danger" /> |
        <a asp-action="Index">Listeye Geri Dön</a>
    </form>
</div>