<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KutuphaneProjesi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KutuphaneProjesi.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="container">
        <div class="row justify-content-center align-items-center" style="min-height: 80vh;">
            <div class="col-md-6 col-lg-4 card shadow-sm p-4">
                <main role="main" class="pb-3">
                    @if (TempData["BasariMesaji"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["BasariMesaji"]
                        </div>
                    }
                    @if (TempData["HataMesaji"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["HataMesaji"]
                        </div>
                    }
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - KutuphaneProjesi
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    ...
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false) 

</body>
</html>
 